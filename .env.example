# Скопируйте в .env, если хотите переопределить значения по умолчанию.
# Без .env всё работает на значениях ниже (только для локальной разработки!).
# Пароли применяются при ПЕРВОМ создании тома Postgres; после смены выполните: docker compose down -v

# Порт Postgres на хосте (подключение из IDE, DBeaver, psql). 5433, чтобы не мешать локальному PostgreSQL на 5432
POSTGRES_HOST_PORT=5433

POSTGRES_ADMIN_PASSWORD=postgres_dev_password
ACCOUNT_DB_PASSWORD=account_dev_password
TRANSFER_DB_PASSWORD=transfer_dev_password
NOTIFICATION_DB_PASSWORD=notification_dev_password
INTERNAL_API_TOKEN=change-me-internal-token
