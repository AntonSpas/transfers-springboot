# Скопируйте в .env, если хотите переопределить значения по умолчанию.
# Без .env всё работает на значениях ниже (только для локальной разработки!).
# Исключение — JWT_*_PATH в конце файла: значений по умолчанию у них нет.
# Пароли применяются при ПЕРВОМ создании тома Postgres; после смены выполните: docker compose down -v

# Порт Postgres на хосте (подключение из IDE, DBeaver, psql). 5433, чтобы не мешать локальному PostgreSQL на 5432
POSTGRES_HOST_PORT=5433

POSTGRES_ADMIN_PASSWORD=postgres_dev_password
ACCOUNT_DB_PASSWORD=account_dev_password
TRANSFER_DB_PASSWORD=transfer_dev_password
NOTIFICATION_DB_PASSWORD=notification_dev_password
# Общий секрет вызовов /internal/**: один и тот же у account-service (проверяет) и transfer-service (отправляет).
# Его же проверяет notification-service на своих /internal/** (ручная повторная отправка уведомлений).
# notification-service, запущенный из IDE, этот файл не читает: для него задайте переменную окружения.
INTERNAL_API_TOKEN=change-me-internal-token

# Ключи JWT (RS256) для сервисов, запущенных ИЗ IDE или через mvn spring-boot:run.
# JWT_PRIVATE_KEY_PATH нужен только account-service (выдаёт токены), JWT_PUBLIC_KEY_PATH нужен и ему, и transfer-service
# (проверяет подпись); у transfer-service значения по умолчанию нет, без пути он не стартует.
# Создаются скриптом scripts/gen-keys.sh. Пути абсолютные и с ПРЯМЫМИ слэшами, даже на Windows:
# .env читается как .properties, обратный слэш там — экранирование (C:\Projects\t... ломается).
# Docker Compose эти две переменные в контейнер не передаёт: там пути зафиксированы (/keys/...), папка keys монтируется только для чтения.
JWT_PRIVATE_KEY_PATH=/absolute/path/to/transfers-springboot/keys/private.pem
JWT_PUBLIC_KEY_PATH=/absolute/path/to/transfers-springboot/keys/public.pem

# transfer-service (необязательно, значения по умолчанию подходят для локальной разработки):
# адрес account-service при запуске из IDE; в Docker Compose задан http://account-service:8080
# ACCOUNT_SERVICE_URL=http://localhost:8081
# выключатель фонового добивания зависших PENDING (интервалы и пороги — в application.yml transfer-service)
# PENDING_RETRY_ENABLED=true
# выключатель публикации outbox в Kafka (планировщик и создание топика transfers.events.v1); при false события копятся
# в outbox_events и уйдут после включения (интервал, размер партии, таймаут — в application.yml transfer-service)
# OUTBOX_ENABLED=true

# notification-service (необязательно, значения по умолчанию подходят для локальной разработки):
# выключатель потребителя transfers.events.v1 (слушатель и создание топика transfers.events.v1.DLT); при false события
# остаются в Kafka и обработаются после включения (повторы и паузы — в application.yml notification-service)
# CONSUMER_ENABLED=true
# выключатель отправки уведомлений (dispatcher); при false уведомления копятся в статусе NEW и уйдут после включения
# (интервал и размер партии — в application.yml notification-service)
# DISPATCH_ENABLED=true
