# Скопируйте в .env, если хотите переопределить значения по умолчанию.
# Без .env всё работает на значениях ниже (только для локальной разработки!).
# Исключение — JWT_*_PATH в конце файла: значений по умолчанию у них нет.
# Пароли применяются при ПЕРВОМ создании тома Postgres; после смены выполните: docker compose down -v

# Порт Postgres на хосте (подключение из IDE, DBeaver, psql). 5433, чтобы не мешать локальному PostgreSQL на 5432
POSTGRES_HOST_PORT=5433

POSTGRES_ADMIN_PASSWORD=postgres_dev_password
ACCOUNT_DB_PASSWORD=account_dev_password
TRANSFER_DB_PASSWORD=transfer_dev_password
NOTIFICATION_DB_PASSWORD=notification_dev_password
INTERNAL_API_TOKEN=change-me-internal-token

# Ключи JWT (RS256) для account-service, запущенного ИЗ IDE или через mvn spring-boot:run.
# Создаются скриптом scripts/gen-keys.sh. Пути абсолютные и с ПРЯМЫМИ слэшами, даже на Windows:
# .env читается как .properties, обратный слэш там — экранирование (C:\Projects\t... ломается).
# Docker Compose эти две переменные в контейнер не передаёт: там пути зафиксированы (/keys/...), папка keys монтируется только для чтения.
JWT_PRIVATE_KEY_PATH=/absolute/path/to/transfers-springboot/keys/private.pem
JWT_PUBLIC_KEY_PATH=/absolute/path/to/transfers-springboot/keys/public.pem
